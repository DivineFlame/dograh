# Dograh on Dokploy — paste these into the Compose service's "Environment" tab
# (Dokploy writes them to a .env next to docker-compose.yaml). Never commit a
# filled-in copy of this file.
#
# Generate each secret with:  openssl rand -hex 32
# (Dokploy's Environment editor also offers ${{password:32}}-style helpers.)

# --- Public identity --------------------------------------------------------
# Domain users open in the browser. Its DNS A record must point at the
# Dokploy server BEFORE the first deploy, or Let's Encrypt can't issue a cert.
PUBLIC_HOST=voice.octaveaiautomation.com

# --- WebRTC media (coturn) — required for audio -----------------------------
# Public IPv4 of the Dokploy server (raw IP recommended).
TURN_HOST=62.72.57.159
TURN_SECRET=hjguacdsghgsad87968sydathewqjpisad098uweqhd

# --- Secrets ----------------------------------------------------------------
OSS_JWT_SECRET=jhgkhjdsaw89ou893k321lpoimgfd;dguygdqnqbx
# Baked into the Postgres volume on first deploy; changing it later does NOT
# re-key the existing database.
POSTGRES_PASSWORD=jkhiusadt73jixnhsawdcvftfewdqjfwern
REDIS_PASSWORD=jhjdsfhiuyhewmjke39ewqdnqed3wbdspsdj
MINIO_ROOT_USER=dograh
MINIO_ROOT_PASSWORD=kljoiayudeqwbei98967y32kdrfnjisdfapjudan

# --- Images -----------------------------------------------------------------
# Pin to a release tag (see CHANGELOG.md) for predictable upgrades/rollback.
REGISTRY=dograhai
DOGRAH_VERSION=latest

# --- Traefik (Dokploy defaults — leave as-is) -------------------------------
TRAEFIK_CERTRESOLVER=letsencrypt
# Unique prefix for Traefik router names. Change it if you run a second Dograh
# (e.g. staging) on the same Dokploy server.
ROUTER_PREFIX=dograh

# --- Optional ---------------------------------------------------------------
# ENABLE_SIGNUP=false          # invite-only after you create the first account
# ENABLE_TELEMETRY=false
# FORCE_TURN_RELAY=false
# TELEPHONY_WS_TOKEN_SECRET=   # sign telephony media WebSocket URLs
# ENABLE_AWS_S3=false           # use S3 instead of bundled MinIO, plus:
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / S3_BUCKET= / S3_REGION=
